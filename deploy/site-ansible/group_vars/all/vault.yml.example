# Copy into an encrypted vault:
#   ansible-vault create group_vars/all/vault.yml
# and paste this in with real values.

# Admins only. Generate with: openssl passwd -6
# For an existing account: sudo getent shadow <name> | cut -d: -f2
vault_user_password_hashes:
  alan: "$6$replace$me"

vault_site_env:
  GITHUB_CLIENT_ID: "Iv1.replace-me"
  GITHUB_CLIENT_SECRET: "replace-me"
