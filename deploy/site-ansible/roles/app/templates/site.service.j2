# Managed by Ansible
[Unit]
Description={{ site_description }}
After=network-online.target
Wants=network-online.target

[Service]
User={{ site_name }}
Group={{ site_name }}
# Secrets only (GitHub client id and secret); settings are flags below.
EnvironmentFile=/etc/site/site.env
StateDirectory={{ site_name }}
WorkingDirectory=/var/lib/{{ site_name }}
ExecStart={{ site_root }}/current \
    -db %S/{{ site_name }}/site.db \
    -port {{ site_port }} \
{% if site_domain %}
    -domain {{ site_domain }} \
    -http-port {{ site_http_port }} \
    -cert-dir %S/{{ site_name }}/certs \
{% endif %}
{% if site_shutdown_delay %}
    -shutdown-delay {{ site_shutdown_delay }} \
{% endif %}
{% if site_extra_args %}
    {{ site_extra_args }} \
{% endif %}
    -base-url {{ site_base_url }}
Restart=on-failure

# Bind ports below 1024 without root, and nothing more.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
