#!/bin/bash
# Managed by Ansible.
# Points current at a release already on the server and restarts the site.
# The site group runs it with sudo; only CI's deploy user can add releases,
# so this can choose between CI-built binaries but never introduce one.
#   sudo site-rollback            list releases, newest first
#   sudo site-rollback previous   the release deployed before the live one
#   sudo site-rollback NAME       a release by name, e.g. site-20261031120000
set -euo pipefail
PATH=/usr/sbin:/usr/bin

root={{ site_root }}
releases="$root/releases"
live="$(readlink -f "$root/current" || true)"

# Release names, newest first. Half-uploaded .tmp files don't match.
# ls is only here to sort by time; every name it gives is checked against
# the release pattern, which has no spaces or globs, before it is used.
names() {
  local p f
  # shellcheck disable=SC2045
  for p in $(ls -1td -- "$releases"/site-* 2>/dev/null); do
    f="${p##*/}"
    if [[ "$f" =~ ^site-[A-Za-z0-9-]+$ ]]; then echo "$f"; fi
  done
}

case "${1:-}" in
  "")
    for f in $(names); do
      if [ "$releases/$f" = "$live" ]; then echo "$f  (live)"; else echo "$f"; fi
    done
    exit 0
    ;;
  previous)
    target=""
    seen=""
    for f in $(names); do
      if [ -n "$seen" ]; then target="$f"; break; fi
      if [ "$releases/$f" = "$live" ]; then seen=1; fi
    done
    if [ -z "$target" ]; then
      echo "no release older than the live one" >&2
      exit 1
    fi
    ;;
  *)
    target="$1"
    ;;
esac

# A plain release name only: no paths, no dot files, no half-uploads.
if ! [[ "$target" =~ ^site-[A-Za-z0-9-]+$ ]]; then
  echo "not a release name: $target" >&2
  exit 1
fi
dest="$releases/$target"
if [ ! -f "$dest" ] || [ -L "$dest" ]; then
  echo "no such release: $target (run site-rollback to list them)" >&2
  exit 1
fi
if [ "$dest" = "$live" ]; then
  echo "$target is already live"
  exit 0
fi

ln -sfn "$dest" "$root/current.tmp"
mv -T "$root/current.tmp" "$root/current"     # atomic swap
systemctl restart {{ site_name }}.service
logger -t site-rollback "${SUDO_USER:-root} rolled back to $target (was $(basename "$live"))"
echo "now live: $target"
